# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Rust build artifacts
app/H188a_toolkit/target/
app/H168n_toolkit/target/
**/target/

# Virtual environments
.env
.venv
env/
venv/

# Logs and runtime artifacts
logs/
*.log
app/logs/*.log
*.tmp
*.temp

# Sensitive router credentials (keep config.example.ini tracked)
app/config.ini
app/H188a_toolkit/config.ini
app/H168n_toolkit/config.ini

# Extracted firmware samples and uploaded binaries
Firmware/*/extracted_sample/
Firmware/*/rootfs.squashfs
Firmware/uploaded_firmware.bin

# OS & IDE files
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
.DS_Store
.idea/
.vscode/
*.swp
*.swo
